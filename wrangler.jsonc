{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queens",
  "main": "api/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    // Only the API wakes the Worker. Pages and images are served straight from
    // the asset store, which costs no Worker request.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "queens",
      "database_id": "e73a3ed6-c598-4ecb-b0b7-6d72d4694069",
      "migrations_dir": "migrations"
    }
  ]
}
