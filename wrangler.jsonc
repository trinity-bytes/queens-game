{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "queens",
  "account_id": "db1565ec7c4461765cfe458ae6b363a8",
  "main": "api/index.ts",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "queens.jahattrinidad.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
    // Only the API wakes the Worker. Pages and images are served straight from
    // the asset store, which costs no Worker request.
    "run_worker_first": ["/api/*"]
  },
  // Per address and per Cloudflare location. A solved board takes minutes, so
  // this leaves real play untouched and only stops scripted floods.
  "ratelimits": [
    {
      "name": "SUBMISSION_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "queens",
      "database_id": "e73a3ed6-c598-4ecb-b0b7-6d72d4694069",
      "migrations_dir": "migrations"
    }
  ]
}
