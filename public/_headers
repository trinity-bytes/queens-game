# Applied by Cloudflare to the static files; the Worker's own responses are not covered.
# Next's static export inlines its bootstrap scripts, hence 'unsafe-inline', and
# canvas-confetti draws in a worker it starts from a blob URL, hence blob:.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Content-addressed: the hash is in the filename, so a copy never goes stale.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
